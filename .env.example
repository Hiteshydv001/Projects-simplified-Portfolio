# Public site URL used for metadata and write-origin checks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: notes, articles, and the public Analytics dashboard
MONGODB_URI=

# Optional: direct contact delivery (server only). Without these, the form opens an email draft.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=hiteshofficial0001@gmail.com

# Optional: drawing recognition (server only)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional: Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=

# Optional: members sign-in with NexusID (OpenID Connect, server only). Without these, /members shows sign-in as unavailable.
NEXUSID_ISSUER=https://nexusid-ten.vercel.app
NEXUSID_CLIENT_ID=
# Only for a "Web app" (confidential) application; leave empty for an SPA (public) application.
NEXUSID_CLIENT_SECRET=
# At least 32 random characters. Signs the session cookie: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
